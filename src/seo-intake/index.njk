---
layout: layouts/site.njk
permalink: /seo-intake/
title: "SEO Client Intake Form | Freeland"
description: "Onboarding form for Freeland SEO clients."
noindex: true
breadcrumbs:
  - { name: "Home", url: "/" }
  - { name: "SEO", url: "/services/seo/" }
  - { name: "SEO client intake", url: "/seo-intake/" }
schema: []
---
<section class="page-top section-tight" aria-labelledby="intake-title">
  <div class="wrap page-head">
    <h1 id="intake-title">SEO client intake form</h1>
    <p class="lede">Thank you for choosing Freeland for your SEO. Please fill out this form so we can build your custom plan. It takes about 5 minutes.</p>
  </div>
</section>

<section class="section-tight rule-top" aria-label="Intake form">
  <div class="wrap">
    <form action="https://api.web3forms.com/submit" method="POST" id="intake-form" class="form-grid">
        <input type="hidden" name="access_key" value="af9a5ef5-c8be-450b-8fdd-9039551baa76" />
        <input type="hidden" name="subject" value="New SEO Client Intake" />
        <input type="hidden" name="redirect" value="https://freelandme.com/seo-intake/confirmation/" />
        <input type="checkbox" name="botcheck" hidden tabindex="-1" autocomplete="off" aria-hidden="true" />

        <!-- Business Information -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">Business Information</h2>

          <div class="field">
            <label for="business_name">Business Name *</label>
            <input type="text" id="business_name" name="business_name" required />
          </div>
          <div class="field">
            <label for="website_url">Website URL *</label>
            <input type="url" id="website_url" name="website_url" placeholder="https://yourbusiness.com" required />
          </div>
          <div class="field">
            <label for="industry">Industry *</label>
            <input type="text" id="industry" name="industry" placeholder="e.g. Plumbing, Restaurant, Real Estate" required />
          </div>
          <div class="field">
            <label for="year_founded">Year Founded</label>
            <input type="text" id="year_founded" name="year_founded" placeholder="e.g. 2018" />
          </div>
        <div class="field field-wide">
          <label for="locations">Location(s)</label>
          <input type="text" id="locations" name="locations" placeholder="e.g. Palm Coast, FL / Multiple locations" />
        </div>
          <div class="field">
            <label for="contact_name">Primary Contact Name *</label>
            <input type="text" id="contact_name" name="contact_name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        <div class="field field-wide">
          <label for="phone">Phone *</label>
          <input type="tel" id="phone" name="phone" placeholder="(386) 555-0100" required autocomplete="tel" />
        </div>

        <!-- About Your Business -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">About Your Business</h2>

        <div class="field field-wide">
          <label for="business_description">What does your business do?</label>
          <textarea id="business_description" name="business_description" rows="3" placeholder="Describe your products or services..."></textarea>
        </div>
        <div class="field field-wide">
          <label for="ideal_customer">Who is your ideal customer?</label>
          <textarea id="ideal_customer" name="ideal_customer" rows="2" placeholder="e.g. Homeowners aged 30-55 in the Palm Coast area"></textarea>
        </div>
        <div class="field field-wide">
          <label for="geographic_area">Geographic area served</label>
          <select id="geographic_area" name="geographic_area">
            <option value="" disabled selected>Select one...</option>
            <option>Local (single city or county)</option>
            <option>Regional (multi-city or state)</option>
            <option>National</option>
            <option>International</option>
          </select>
        </div>
        <div class="field field-wide">
          <label for="competitors">Top 3 competitors</label>
          <textarea id="competitors" name="competitors" rows="3" placeholder="List competitor names or websites"></textarea>
        </div>

        <!-- Current Marketing -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">Current Marketing</h2>

        <div class="field field-wide">
          <label>What marketing are you currently doing? (check all that apply)</label>
          <div class="check-list" style="display:grid;gap:10px;margin-top:10px">
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="Social media posting" /> Social media posting</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="Google Ads" /> Google Ads</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="Facebook/Instagram ads" /> Facebook/Instagram ads</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="Email marketing" /> Email marketing</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="Blog/content" /> Blog/content</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="SEO (previous or current)" /> SEO (previous or current)</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="Google Business Profile" /> Google Business Profile</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="marketing[]" value="None of the above" /> None of the above</label>
          </div>
        </div>
          <div class="field">
            <label for="previous_seo">Have you worked with an SEO company before?</label>
            <select id="previous_seo" name="previous_seo">
              <option value="" disabled selected>Select one...</option>
              <option>Yes</option>
              <option>No</option>
            </select>
          </div>
        <div class="field field-wide">
          <label for="previous_seo_details">If yes, what did they do?</label>
          <textarea id="previous_seo_details" name="previous_seo_details" rows="2" placeholder="e.g. Monthly blog posts, backlinks, technical fixes..."></textarea>
        </div>

        <!-- Your Goals -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">Your Goals</h2>

        <div class="field field-wide">
          <label>What are your goals? (check all that apply)</label>
          <div class="check-list" style="display:grid;gap:10px;margin-top:10px">
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="More website traffic" /> More website traffic</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="More phone calls/leads" /> More phone calls/leads</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="Rank higher for specific terms" /> Rank higher for specific terms</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="Show up in Google Maps" /> Show up in Google Maps</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="Beat a specific competitor" /> Beat a specific competitor</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="Build brand awareness" /> Build brand awareness</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="Sell products online" /> Sell products online</label>
            <label class="check" style="display:flex;gap:10px;align-items:center;font-weight:400"><input type="checkbox" style="width:auto;min-height:0" name="goals[]" value="Other" /> Other</label>
          </div>
        </div>
        <div class="field field-wide">
          <label for="target_keywords">Keywords you want to rank for</label>
          <textarea id="target_keywords" name="target_keywords" rows="2" placeholder="e.g. plumber near me, best restaurant palm coast, custom wood carving"></textarea>
        </div>
        <div class="field field-wide">
          <label for="customer_value">What is a new customer worth to you?</label>
          <input type="text" id="customer_value" name="customer_value" placeholder="e.g. a typical order, or varies" />
        </div>

        <!-- Website Details -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">Website Details</h2>

          <div class="field">
            <label for="platform">Website platform</label>
            <select id="platform" name="platform">
              <option value="" disabled selected>Select one...</option>
              <option>WordPress</option>
              <option>Wix</option>
              <option>Squarespace</option>
              <option>Shopify</option>
              <option>Custom</option>
              <option>Don't know</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="hosting">Hosting provider</label>
            <select id="hosting" name="hosting">
              <option value="" disabled selected>Select one...</option>
              <option>GoDaddy</option>
              <option>SiteGround</option>
              <option>Bluehost</option>
              <option>Hostinger</option>
              <option>Netlify</option>
              <option>Don't know</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="gbp_status">Google Business Profile set up?</label>
            <select id="gbp_status" name="gbp_status">
              <option value="" disabled selected>Select one...</option>
              <option>Yes, verified</option>
              <option>Yes, not verified</option>
              <option>No</option>
              <option>Not sure</option>
            </select>
          </div>
          <div class="field">
            <label for="ga_status">Google Analytics set up?</label>
            <select id="ga_status" name="ga_status">
              <option value="" disabled selected>Select one...</option>
              <option>Yes</option>
              <option>No</option>
              <option>Not sure</option>
            </select>
          </div>
        <div class="field field-wide">
          <label for="gsc_status">Google Search Console set up?</label>
          <select id="gsc_status" name="gsc_status">
            <option value="" disabled selected>Select one...</option>
            <option>Yes</option>
            <option>No</option>
            <option>Not sure</option>
          </select>
        </div>

        <!-- Timeline -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">Timeline</h2>

          <div class="field">
            <label for="timeline">How soon do you want to get started?</label>
            <select id="timeline" name="timeline">
              <option value="" disabled selected>Select one...</option>
              <option>Immediately</option>
              <option>Within 2 weeks</option>
              <option>Within a month</option>
              <option>Just exploring</option>
            </select>
          </div>
          <div class="field">
            <label for="importance">How important is SEO to your business?</label>
            <select id="importance" name="importance">
              <option value="" disabled selected>Select one...</option>
              <option>Critical, we need this now</option>
              <option>Important, high priority</option>
              <option>Exploring, want to learn more</option>
            </select>
          </div>

        <!-- Anything Else -->
        <h2 class="field-wide" style="font-size:24px;margin-top:18px">Anything Else</h2>

        <div class="field field-wide">
          <label for="additional_notes">Anything else we should know?</label>
          <textarea id="additional_notes" name="additional_notes" rows="4" placeholder="Special requests, concerns, deadlines, or anything that would help us build a better plan for you..."></textarea>
        </div>

        <div class="form-actions"><button type="submit" class="button button-primary">Submit intake form</button></div>
        <p class="helper form-actions">We'll review your information and schedule a call within 2 business days.</p>
      </form>
  </div>
</section>

<section class="section-tight rule-top" aria-labelledby="intake-next">
  <div class="wrap split">
    <h2 id="intake-next" class="split-head">Not a client yet?</h2>
    <div class="body-copy">
      <p class="lede">Start with a plan built on your own numbers. It is free and you keep it either way.</p>
      <div class="actions"><a class="button button-primary" href="/growth-roadmap/" data-cta="intake_roadmap">Get your Growth Roadmap</a></div>
    </div>
  </div>
</section>
