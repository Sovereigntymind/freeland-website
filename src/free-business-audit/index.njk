---
layout: layouts/site.njk
permalink: /free-business-audit/
title: "Instant Site Check: 19 Checks, Emailed to You | Freeland"
description: "A free automated check of your website: 19 checks across findability, reachability, trust and performance. The report is emailed to you."
breadcrumbs:
  - { name: "Home", url: "/" }
  - { name: "Instant site check", url: "/free-business-audit/" }
schema: []
---
<section class="page-top section" aria-labelledby="check-title">
  <div class="wrap apply">
    <div class="apply-copy page-head">
      <h1 id="check-title">Instant site check.</h1>
      <p class="lede">An automated scan of your website. 19 checks across findability, reachability, trust and performance, with a score and what to fix. The report is emailed to you.</p>
      <p>This scan looks at public pages. It cannot verify ad performance, store revenue or account tracking. For Kevin's read, start with the <a href="/growth-roadmap/" data-cta="site_check_roadmap">Growth Roadmap</a>: your public store and ads plus five answers. A deeper read needs account access, agreed on the call.</p>
    </div>
    <form id="gbp-audit-form" class="form-grid" method="post" novalidate>
      <div class="field">
        <label for="business_name">Business name</label>
        <input type="text" id="business_name" name="business_name" required autocomplete="organization" maxlength="200">
      </div>
      <div class="field">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="you@yourbrand.com" required autocomplete="email" spellcheck="false" maxlength="254">
      </div>
      <div class="field">
        <label for="website">Website address</label>
        <input type="url" id="website" name="website" placeholder="https://yourbrand.com" required autocomplete="url" spellcheck="false" aria-describedby="website-hint">
        <p class="field-hint" id="website-hint">Include https:// at the start.</p>
      </div>
      <div class="field">
        <label for="city">City</label>
        <input type="text" id="city" name="city" required autocomplete="address-level2" maxlength="120">
      </div>
      <div class="field">
        <label for="industry">Industry (optional)</label>
        <select id="industry" name="industry">
          <option value="default">Select your industry</option>
          <option value="auto">Auto Repair / Body Shop</option>
          <option value="construction">Construction / Contractor</option>
          <option value="dental">Dental</option>
          <option value="fitness">Fitness / Gym</option>
          <option value="hvac">HVAC</option>
          <option value="insurance">Insurance</option>
          <option value="landscaping">Landscaping</option>
          <option value="legal">Legal / Law Firm</option>
          <option value="medical">Medical / Healthcare</option>
          <option value="plumbing">Plumbing</option>
          <option value="realestate">Real Estate</option>
          <option value="restaurant">Restaurant / Food Service</option>
          <option value="retail">Retail</option>
          <option value="roofing">Roofing</option>
          <option value="salon">Salon / Spa</option>
          <option value="default">Other</option>
        </select>
      </div>
      <div class="field">
        <label for="phone">Phone (optional)</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="40">
      </div>
      <div class="hp" aria-hidden="true">
        <label for="company_url">Company URL (leave this empty)</label>
        <input type="text" id="company_url" name="company_url" tabindex="-1" autocomplete="off">
      </div>
      <div class="form-actions">
        <button type="submit" class="button button-primary" id="gbp-submit-btn" disabled>Run my site check</button>
        <p class="helper">Free. The scan takes up to 30 seconds.</p>
      </div>
      <noscript><p class="noscript-note field-wide">This form needs JavaScript. Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> instead and Kevin will reply.</p></noscript>
      <div class="form-status form-error" id="gbp-audit-error" role="alert" tabindex="-1" hidden></div>
    </form>
  </div>
</section>

<section class="section rule-top" aria-labelledby="covers-title">
  <div class="wrap split">
    <h2 id="covers-title" class="split-head">What the check covers</h2>
    <dl class="rows">
      <div>
        <dt>Findability</dt>
        <dd>Whether search engines and people can find the site.</dd>
      </div>
      <div>
        <dt>Reachability</dt>
        <dd>Whether a visitor can reach you once they are there.</dd>
      </div>
      <div>
        <dt>Trust</dt>
        <dd>The signals a first-time visitor looks for before buying.</dd>
      </div>
      <div>
        <dt>Performance</dt>
        <dd>How the site loads and behaves.</dd>
      </div>
    </dl>
  </div>
</section>

{% set ctaHeading = "Want Kevin's read of the buying path?" %}
{% set ctaId = "site_check_band_roadmap" %}
{% include "partials/cta-band.njk" %}

<script>
  /* Instant site check client. The Netlify function (business-audit) is frozen: the JSON body below is
     unchanged from the old page. PLAN R1-8: no Web3Forms or n8n side sends from the browser, a filled
     honeypot sends nothing and fires nothing, and site_check_submit fires only on HTTP 200 with
     emailQueued true. Success still redirects to /free-business-audit/thank-you/. */
  (function () {
    var form = document.getElementById("gbp-audit-form");
    var submitBtn = document.getElementById("gbp-submit-btn");
    var errorBox = document.getElementById("gbp-audit-error");
    if (!form || !submitBtn) return;
    var label = submitBtn.textContent;
    var started = false;
    var EMAIL = "kevin@freelandme.com";

    function fl() { return window.FL || {}; }
    function showError(title, msg) {
      if (!errorBox) return;
      errorBox.textContent = "";
      var h = document.createElement("h3"); h.textContent = title;
      var p = document.createElement("p"); p.textContent = msg + " Or email " + EMAIL + " and Kevin will send it.";
      errorBox.appendChild(h); errorBox.appendChild(p);
      errorBox.hidden = false;
      errorBox.focus();
      if (typeof fl().formEvent === "function") fl().formEvent("form_error", { form_id: "site_check", error_type: "server" });
    }
    function reset() {
      submitBtn.textContent = label;
      submitBtn.disabled = false;
      submitBtn.removeAttribute("aria-busy");
    }

    form.addEventListener("input", function (e) {
      if (started) return;
      var hp = form.querySelector("#company_url");
      if ((e && e.target && e.target.id === "company_url") || (hp && hp.value)) return;
      started = true;
      if (typeof fl().formEvent === "function") fl().formEvent("form_start", { form_id: "site_check" });
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (submitBtn.disabled) return;

      // Inline validation (same pattern as the roadmap form): message under each field, focus the first.
      var firstBad = null;
      form.querySelectorAll("input[required]").forEach(function (el) {
        var msgId = el.id + "-err", msg = document.getElementById(msgId);
        if (!msg) { msg = document.createElement("p"); msg.className = "field-error"; msg.id = msgId; msg.setAttribute("aria-live", "polite"); el.insertAdjacentElement("afterend", msg); }
        var bad = !el.value.trim() || !el.checkValidity();
        msg.textContent = bad ? (el.type === "email" ? "Add a valid email." : el.type === "url" ? "Add your full site address, starting with https://" : "This field is required.") : "";
        el.setAttribute("aria-invalid", bad ? "true" : "false");
        var desc = (el.getAttribute("aria-describedby") || "").split(" ").filter(function (x) { return x && x !== msgId; });
        if (bad) desc.push(msgId);
        if (desc.length) el.setAttribute("aria-describedby", desc.join(" ")); else el.removeAttribute("aria-describedby");
        if (bad && !firstBad) firstBad = el;
      });
      if (firstBad) {
        firstBad.focus();
        if (typeof fl().formEvent === "function") fl().formEvent("form_error", { form_id: "site_check", error_type: "validation" });
        return;
      }

      // Honeypot filled: send nothing, fire nothing. The visitor-facing result looks the same.
      if (form.querySelector('[name="company_url"]').value) {
        window.location.href = "/free-business-audit/thank-you/";
        return;
      }

      var data = {
        business_name: form.querySelector('[name="business_name"]').value,
        email: form.querySelector('[name="email"]').value,
        website: form.querySelector('[name="website"]').value,
        city: form.querySelector('[name="city"]').value,
        industry: form.querySelector('[name="industry"]').value,
        phone: form.querySelector('[name="phone"]').value,
        source: "business-audit-landing-page",
        timestamp: new Date().toISOString()
      };

      if (errorBox) errorBox.hidden = true;
      submitBtn.textContent = "Running your check... (up to 30s)";
      submitBtn.disabled = true;
      submitBtn.setAttribute("aria-busy", "true");

      // The function runs the scan and queues the report email. Redirect only once it confirms the email is queued.
      var ctrl = window.AbortController ? new AbortController() : null;
      var timer;
      var limit = new Promise(function (_, reject) {
        timer = setTimeout(function () {
          var error = new Error("Site check deadline exceeded"); error.timeout = true;
          reject(error);
          if (ctrl) ctrl.abort();
        }, 35000);
      });
      var work = fetch("/.netlify/functions/business-audit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
        signal: ctrl ? ctrl.signal : undefined
      }).then(function (resp) {
        return resp.json().then(function (body) { return { status: resp.status, body: body }; });
      });
      Promise.race([work, limit]).then(function (result) {
          var resp = result, body = result.body;
          if (resp.status === 200 && body && body.emailQueued === true) {
            if (typeof fl().track === "function") fl().track("site_check_submit", { form_id: "site_check" });
            setTimeout(function () { window.location.href = "/free-business-audit/thank-you/"; }, 150);
          } else if (resp.status === 429) {
            reset();
            showError("Too many checks from this connection.", "Wait a minute and run it again.");
          } else if (resp.status === 400) {
            reset();
            showError("The check could not start.", "Make sure the business name, email and website address are filled in, then run it again.");
          } else {
            reset();
            showError("The check ran, but the report was not emailed.", "Run it again in a minute.");
          }
      }).catch(function (error) {
        reset();
        if (error && error.timeout) showError("The site check took too long.", "We could not confirm whether the report was emailed. Your answers are still here. Run the check again.");
        else showError("We could not reach the server.", "Check your connection and run it again.");
      }).finally(function () { clearTimeout(timer); });
    });

    submitBtn.disabled = false;
  })();
</script>
